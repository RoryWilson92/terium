# Headroom for TLS and the JSON writer.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The release image does not fit the default app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Wall boards stay quiet. INFO is the compile-time ceiling, so log_serial can still raise the level.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
# CA bundle used to verify the Supabase certificate.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Person mode reads CSI from the other boards' probes.
CONFIG_ESP_WIFI_CSI_ENABLED=y
